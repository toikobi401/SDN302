MONGO_URI=mongodb://127.0.0.1:27017/bookstore?replicaSet=rs0
PORT=3000
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d
CORS_ORIGINS=http://localhost:3001
SHIPPING_FEE_VND=0

# Used only by npm run db:seed. Do not commit real credentials.
ADMIN_NAME=Bookstore Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Optional delivery account; leave SHIPPER_EMAIL empty to skip it.
SHIPPER_NAME=Shipper
SHIPPER_EMAIL=
SHIPPER_PASSWORD=

# Cloudinary credentials: fill these values in your local .env file.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=bookstore

# payOS payment channel keys from my.payos.vn. Online payment returns 503 until these are set.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Where customers return to after paying.
CLIENT_URL=http://localhost:3001
