MONGO_URI=mongodb://127.0.0.1:27017/bookstore?replicaSet=rs0
PORT=3000
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SHIPPING_FEE_VND=0

# Used only by npm run admin:create. Do not commit real credentials.
ADMIN_NAME=Bookstore Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cloudinary credentials: fill these values in your local .env file.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=bookstore
